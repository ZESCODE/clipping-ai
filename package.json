{
  "name": "clipping-ai",
  "version": "1.0.0",
  "description": "AI-powered automated clipping platform for Whop Content Rewards, Vyro, and other clip marketplaces",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@vercel/postgres": "^0.9.0",
    "@ffmpeg/ffmpeg": "^0.12.6",
    "@ffmpeg/util": "^0.12.1",
    "axios": "^1.6.2",
    "axios-retry": "^3.9.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "openai": "^4.20.1",
    "puppeteer": "^21.6.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.33.0",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "vite": "^5.4.21"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "ffmpeg-static@5.3.0": true,
    "puppeteer": true,
    "sharp": true
  }
}